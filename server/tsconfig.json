{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../server-dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false,
    /* Transition: .js and .ts server files coexist; only .ts is type-checked. */
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": false,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["test", "node_modules", "../server-dist", "../dist"]
}
